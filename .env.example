# Public application origin used for canonical metadata, sitemap, and robots URLs.
# Set this to the deployed origin without a path; localhost is used only by next dev.
NEXT_PUBLIC_SITE_URL=

# Public Supabase values from the project's Connect dialog.
# These are safe for the browser only when Row Level Security is configured.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Use "mock" only for local UI development. Production remains unconfigured
# until the real Supabase adapter and project credentials are connected.
NEXT_PUBLIC_AUTH_MODE=mock

# Optional server-only AI generation. Never prefix this key with NEXT_PUBLIC_.
# Without a key, the AI workspace shows an honest unavailable state.
OPENAI_API_KEY=
# Structured-output-capable Responses API model. The default is gpt-4o-mini.
OPENAI_MODEL=gpt-4o-mini
